{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and every per-document window",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-create",
    "core:webview:allow-print",
    "dialog:default",
    "store:default",
    "window-state:default",
    "opener:default"
  ]
}
