{
  "name": "seepdf",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "postinstall": "node scripts/fetch-pdfium.mjs && node scripts/prepare-ocr.mjs --quiet",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs --strict",
    "check:size": "node scripts/check-bundle-size.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs --write",
    "check": "npm run typecheck && npm run test && npm run check:i18n"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "~2.12.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "lucide-react": "^1.46.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
