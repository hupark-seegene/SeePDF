# SeePDF patch for pdfium-render 0.9.4
#
# Applied to the vendored copy at vendor/pdfium-render, which src-tauri/Cargo.toml consumes
# with `[patch.crates-io] pdfium-render = { path = "../vendor/pdfium-render" }`.
#
# The API change is purely additive: five public raw-handle accessors (ARCHITECTURE.md §1.3),
# in one new file plus two one-line hooks. The Cargo.toml changes are packaging only.
#
# Regenerate with:
#   REG=~/.cargo/registry/src/*/pdfium-render-0.9.4
#   diff -u --new-file $REG/{Cargo.toml,src/lib.rs,src/pdfium.rs} b/...
#
# Files removed from the vendored copy (none referenced by a SeePDF build): test/, .github/,
# Cargo.lock, Cargo.toml.orig, and every include/pdfium_* directory except pdfium_7881
# (include/ is only read by build.rs under the `bindings` feature, which SeePDF never enables).
--- a/Cargo.toml	2006-07-24 10:21:28
+++ b/Cargo.toml	2026-09-15 23:38:47
@@ -39,6 +39,15 @@
 license = "MIT OR Apache-2.0"
 repository = "https://github.com/ajrcarey/pdfium-render"
 
+# SeePDF patch: this crate is consumed as a `[patch.crates-io]` *path* dependency, so cargo
+# does not apply `--cap-lints allow` to it and its own warnings would fail the project's
+# `cargo clippy -- -D warnings` gate. Its lints are not ours to fix.
+[lints.rust]
+warnings = "allow"
+
+[lints.clippy]
+all = "allow"
+
 [features]
 bindings = ["dep:bindgen"]
 console_log = []
@@ -105,11 +114,11 @@
 
 [lib]
 name = "pdfium_render"
-crate-type = [
-    "lib",
-    "staticlib",
-    "cdylib",
-]
+# SeePDF patch: the published crate also builds `staticlib` + `cdylib`. As a `[patch]`ed
+# path dependency that makes two units write `libpdfium_render.dylib`/`.a` to the same
+# filename, which cargo warns about and which made `cargo test` fail with E0460 ("found
+# possibly newer version of crate pdfium_render"). SeePDF only ever links the rlib.
+crate-type = ["lib"]
 path = "src/lib.rs"
 doctest = false
 
--- a/src/lib.rs	2006-07-24 10:21:28
+++ b/src/lib.rs	2026-09-15 23:38:47
@@ -91,6 +91,8 @@
 mod error;
 mod pdf;
 mod pdfium;
+// SeePDF patch: additive raw-handle accessors (see src/seepdf_raw.rs).
+mod seepdf_raw;
 mod utils;
 
 /// A prelude for conveniently importing all public `pdfium-render` definitions at once.
--- a/src/pdfium.rs	2006-07-24 10:21:28
+++ b/src/pdfium.rs	2026-09-15 22:46:37
@@ -83,6 +83,19 @@
     }
 }
 
+/// SeePDF patch: returns the global `PdfiumLibraryBindings` instance promoted by the
+/// first `Pdfium::new()` call. Used by `Pdfium::raw_bindings()` in `seepdf_raw.rs`.
+///
+/// Panics if called before a `Pdfium` instance has been constructed, which cannot
+/// happen through the public API because `raw_bindings()` takes `&self`.
+#[inline]
+pub(crate) fn seepdf_global_bindings() -> &'static dyn PdfiumLibraryBindings {
+    BINDINGS
+        .get()
+        .expect("Pdfium bindings have not been initialized")
+        .as_ref()
+}
+
 /// A high-level idiomatic Rust wrapper around Pdfium, the C++ PDF library used by
 /// the Google Chromium project.
 pub struct Pdfium {
--- /dev/null
+++ b/src/seepdf_raw.rs	2026-09-15 22:47:55
@@ -0,0 +1,84 @@
+//! SeePDF additive raw-handle accessors.
+//!
+//! This file is the whole of the SeePDF patch to pdfium-render 0.9.4 (see
+//! `docs/pdfium-patch.diff` and `docs/ARCHITECTURE.md` §1.3). It adds no behaviour:
+//! every function here simply re-exports an existing `pub(crate)` handle, or the
+//! already-initialised global `PdfiumLibraryBindings` instance, as `pub`.
+//!
+//! Rationale: `FPDF_MovePages`, `FPDF_ImportPagesByIndex`, `FPDFPage_Flatten`,
+//! `FPDF_SaveAsCopy` with flags, the whole `FPDFAnnot_*` edit pipeline and the
+//! `FORM_*` fill environment have no safe wrapper in 0.9.4, and the handles they need
+//! are `pub(crate)`. Without these five accessors the only alternative is a *second*
+//! `bind_to_library()` driving a separate `FPDF_DOCUMENT` of the same bytes, which
+//! costs a `save_to_bytes()` + reload (5 ms/MB) per edit.
+//!
+//! Everything returned here is a raw PDFium handle: it is only valid while the Rust
+//! value it came from is alive, and PDFium is not thread-safe, so all use must stay on
+//! the one thread that owns the `Pdfium` instance.
+
+use crate::bindgen::{FPDF_ANNOTATION, FPDF_DOCUMENT, FPDF_FORMHANDLE, FPDF_PAGE};
+use crate::bindings::PdfiumLibraryBindings;
+use crate::pdf::document::form::PdfForm;
+use crate::pdf::document::page::annotation::private::internal::PdfPageAnnotationPrivate;
+use crate::pdf::document::page::annotation::PdfPageAnnotation;
+use crate::pdf::document::page::PdfPage;
+use crate::pdf::document::PdfDocument;
+use crate::pdfium::Pdfium;
+
+impl PdfDocument<'_> {
+    /// Returns the raw `FPDF_DOCUMENT` handle backing this [PdfDocument].
+    ///
+    /// The handle is valid only for as long as this [PdfDocument] is alive.
+    #[inline]
+    pub fn raw_handle(&self) -> FPDF_DOCUMENT {
+        self.handle()
+    }
+}
+
+impl PdfPage<'_> {
+    /// Returns the raw `FPDF_PAGE` handle backing this [PdfPage].
+    ///
+    /// The handle is valid only for as long as this [PdfPage] is alive.
+    #[inline]
+    pub fn raw_handle(&self) -> FPDF_PAGE {
+        self.page_handle()
+    }
+
+    /// Returns the raw `FPDF_DOCUMENT` handle of the document containing this [PdfPage].
+    #[inline]
+    pub fn raw_document_handle(&self) -> FPDF_DOCUMENT {
+        self.document_handle()
+    }
+}
+
+impl PdfForm<'_> {
+    /// Returns the raw `FPDF_FORMHANDLE` of this [PdfForm]'s form fill environment.
+    ///
+    /// The handle is valid only for as long as the containing document is alive.
+    #[inline]
+    pub fn raw_handle(&self) -> FPDF_FORMHANDLE {
+        self.handle()
+    }
+}
+
+impl PdfPageAnnotation<'_> {
+    /// Returns the raw `FPDF_ANNOTATION` handle backing this [PdfPageAnnotation].
+    ///
+    /// The handle is valid only for as long as this [PdfPageAnnotation] is alive.
+    #[inline]
+    pub fn raw_handle(&self) -> FPDF_ANNOTATION {
+        PdfPageAnnotationPrivate::handle(self)
+    }
+}
+
+impl Pdfium {
+    /// Returns the `PdfiumLibraryBindings` instance this crate is using.
+    ///
+    /// This is the *same* instance every high-level object calls through — not a second
+    /// `bind_to_library()` — so raw calls made through it operate on the same PDFium
+    /// global state, and on handles obtained from `raw_handle()` above.
+    #[inline]
+    pub fn raw_bindings(&self) -> &'static dyn PdfiumLibraryBindings {
+        crate::pdfium::seepdf_global_bindings()
+    }
+}
